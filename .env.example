# Don't edit by hand: `neon env pull` (or `neon deploy`) writes these into .env.local
# for the branch linked in .neon. Never commit real values.

# Pooled (PgBouncer, "-pooler" host): used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require"
# Direct: used by migrations (drizzle-kit) and the bulk import script.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Auth.js: signs and encrypts session cookies. Generate with: openssl rand -base64 33
AUTH_SECRET=""

# Google OAuth client (Google Cloud Console -> Google Auth Platform -> Clients).
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
